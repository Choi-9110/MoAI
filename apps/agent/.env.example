# ── 로컬 실행기 ──
PORT=4100

# 백엔드와 동일한 값을 넣을 것. 터널 노출 전에 반드시 설정한다.
AGENT_TOKEN=change-me-to-a-long-random-string

# 동시에 처리할 잡 수. PC 사양에 맞게 조정한다.
MAX_CONCURRENT_JOBS=2

# ── Claude ──
# 비워두면 SDK 가 로컬 인증 프로필을 사용한다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── 작업 디렉터리 ──
# 잡 종료 시 자동 삭제된다. 디버깅이 필요할 때만 KEEP_WORKSPACE=true 로 둘 것.
WORKSPACE_DIR=./workspace
KEEP_WORKSPACE=false

# ── 판정 워커 ──
# 앞에서부터 준비된 판정기를 고른다.
#   claude-cli — PC 에 설치·로그인된 Claude CLI 를 그대로 쓴다 (기본, API 키 불필요)
#   claude-api — ANTHROPIC_API_KEY 로 API 직접 호출
#   gemma      — 로컬 Ollama
JUDGE_PRIORITY=claude-cli,claude-api,gemma

# 판정은 짧은 문서를 다수 처리하므로 생성보다 가벼운 모델을 쓴다.
JUDGE_MODEL=claude-sonnet-5
JUDGE_TIMEOUT_MS=120000

# CLI 실행 파일을 자동으로 못 찾을 때만 지정한다.
# 윈도우 예: C:/nvm4w/nodejs/node_modules/@anthropic-ai/claude-code/bin/claude.exe
CLAUDE_CLI_PATH=

# Gemma 판정기 (대체 경로, 선택)
# Ollama 설치: https://ollama.com  →  ollama pull gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma3:4b
GEMMA_TIMEOUT_MS=120000

# 백엔드 주소 (대기열을 가져오고 결과를 돌려보낸다)
API_BASE_URL=http://localhost:4000/api

# true 로 두면 주기적으로 대기열을 미리 비운다 (사용자가 기다리지 않도록)
ELIGIBILITY_WORKER=false
WORKER_INTERVAL_MS=300000
WORKER_BATCH_SIZE=20

# ── 공고문 읽기 워커 ──
# 접수 중 공고의 첨부(HWP·PDF)를 받아 로컬 Claude 로 신청 자격을 구조화한다.
# 공고당 한 번만 읽는다. 기업이 늘어도 호출 수는 늘지 않는다.
DOCUMENT_WORKER=false
DOCUMENT_INTERVAL_MS=600000
# 읽는 시간대 — 로컬 Claude 는 사용자가 쓰는 자원과 같아서 기본은 밤이다.
# 아무 때나 돌리려면 0-24.
DOCUMENT_ACTIVE_HOURS=22-8
# 이 시각 전에는 시작하지 않는다 (예: 2026-09-18T22:00:00+09:00).
# 자정을 넘는 시간대는 "지금"도 구간 안이라, 오늘 밤부터 돌리려면 이걸 쓴다.
DOCUMENT_NOT_BEFORE=
DOCUMENT_BATCH_SIZE=20
# CLI 동시 실행은 전체 4개 — 사용자 작업이 밀리지 않게 이 워커는 2개만 쓴다
DOCUMENT_CONCURRENCY=2
DOCUMENT_MODEL=claude-sonnet-5
DOCUMENT_TIMEOUT_MS=240000
