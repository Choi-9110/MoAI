# ── 서버 ──
PORT=4000
CORS_ORIGINS=http://localhost:3000

# ── DB (Supabase Postgres) ──
# Supabase 대시보드 > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DB_SSL=true
DB_SYNCHRONIZE=true   # 운영 전환 시 false 로 바꾸고 마이그레이션 사용
DB_LOGGING=false

# ── 실행기 ──
# local = 내 PC 의 agent 서버, api = Anthropic 직결
# 매출 발생 후 API 로 전환할 때는 "api,local" 로만 바꾸면 된다.
EXECUTOR_PRIORITY=local,api

# 로컬 agent 주소 (Cloudflare Tunnel 주소로 교체)
AGENT_BASE_URL=http://localhost:4100
AGENT_TOKEN=change-me-to-a-long-random-string
AGENT_HEALTH_TIMEOUT_MS=3000
AGENT_JOB_TIMEOUT_MS=600000

# ── 폴백용 Anthropic API ──
# 로컬 서버가 죽었을 때만 호출되므로 평소 비용은 발생하지 않는다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── 공공 API ──
# K-Startup: https://www.data.go.kr/data/15125364/openapi.do (자동승인)
KSTARTUP_BASE_URL=https://apis.data.go.kr/B552735/kisedKstartupService01
KSTARTUP_SERVICE_KEY=

# 기업마당: https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi (IP/URL 등록 필요)
BIZINFO_BASE_URL=https://www.bizinfo.go.kr/uss/rss/bizinfoApi.do
BIZINFO_CRTFC_KEY=

# ── Supabase Auth ──
# Project Settings → API 에서 확인
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ── 수집 스케줄 ──
# 매일 04:00 증분(앞 30페이지) / 일요일 03:00 전체
COLLECT_SCHEDULE=false
COLLECT_DAILY_PAGES=30
